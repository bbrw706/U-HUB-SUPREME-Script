ConfigDropdown = ConfigSection:AddDropdown("ConfigDropdown", {Title="เลือกไฟล์ที่จะโหลดนะคัฟ",Values=GetConfigList(),Default=nil,Callback=function(Value)
	if ((Value == "ไม่มีข้อมูลอะ🥀🥀") or not Value) then
