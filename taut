function HoldGrabLogic(zoneId)
	local char = lp.Character or lp.CharacterAdded:Wait();
	local hrp = char:WaitForChild("HumanoidRootPart");
	local zonePos = ZoneData[zoneId].Farm;
	local t1 = TweenService:Create(hrp, TweenInfo.new((hrp.Position - zonePos).Magnitude / _G.FlySpeed, Enum.EasingStyle.Linear), {CFrame=CFrame.new(zonePos)});
	t1:Play();
	t1.Completed:Wait();
	task.wait(0.5);
	local targetRoot = nil;
	local minDist = 999;
	local zonePos = ZoneData[SelectedZoneID].Farm;
	for _, p in ipairs(workspace:GetDescendants()) do
		if p:IsA("ProximityPrompt") then
			local FlatIdent_6D4CB = 0;
			local root;
			while true do
				if (FlatIdent_6D4CB == 0) then
					root = (p.Parent:IsA("BasePart") and p.Parent) or p.Parent:FindFirstChildWhichIsA("BasePart");
					if root then
						local distToZone = (root.Position - zonePos).Magnitude;
						if (distToZone < 150) then
							local model = root:FindFirstAncestorOfClass("Model");
							if (model and (model ~= lp.Character) and not game.Players:GetPlayerFromCharacter(model)) then
								local FlatIdent_10BCC = 0;
								local distToMe;
								while true do
									if (0 == FlatIdent_10BCC) then
										distToMe = (root.Position - hrp.Position).Magnitude;
										if (distToMe < minDist) then
											local FlatIdent_47A9C = 0;
											while true do
												if (FlatIdent_47A9C == 0) then
													minDist = distToMe;
													targetRoot = root;
													break;
												end
											end
										end
										break;
									end
								end
							end
						end
					end
					break;
				end
			end
		end
	end
	if targetRoot then
		local FlatIdent_63487 = 0;
		local tween;
		local prompt;
		while true do
			if (FlatIdent_63487 == 3) then
				task.wait(0.1);
				vInput:SendKeyEvent(false, "E", false, game);
				break;
			end
			if (FlatIdent_63487 == 2) then
				if prompt then
					fireproximityprompt(prompt);
				end
				vInput:SendKeyEvent(true, "E", false, game);
				FlatIdent_63487 = 3;
			end
			if (FlatIdent_63487 == 0) then
				tween = TweenService:Create(hrp, TweenInfo.new((hrp.Position - targetRoot.Position).Magnitude / _G.FlySpeed, Enum.EasingStyle.Linear), {CFrame=targetRoot.CFrame});
				tween:Play();
				FlatIdent_63487 = 1;
			end
			if (FlatIdent_63487 == 1) then
				tween.Completed:Wait();
				prompt = targetRoot:FindFirstChildWhichIsA("ProximityPrompt") or targetRoot.Parent:FindFirstChildWhichIsA("ProximityPrompt");
				FlatIdent_63487 = 2;
			end
		end
	end
	if (targetRoot and not _G.IsHiding) then
		local FlatIdent_8F047 = 0;
		local t2;
		local p;
		while true do
			if (2 == FlatIdent_8F047) then
				vInput:SendKeyEvent(false, "E", false, game);
				firetouchinterest(hrp, targetRoot, 1);
				task.wait(0.2);
				break;
			end
			if (FlatIdent_8F047 == 0) then
				t2 = TweenService:Create(hrp, TweenInfo.new((hrp.Position - targetRoot.Position).Magnitude / _G.FlySpeed, Enum.EasingStyle.Linear), {CFrame=targetRoot.CFrame});
				t2:Play();
				t2.Completed:Wait();
				p = targetRoot.Parent:FindFirstChildWhichIsA("ProximityPrompt", true);
				FlatIdent_8F047 = 1;
			end
			if (FlatIdent_8F047 == 1) then
				if p then
					fireproximityprompt(p);
				end
				vInput:SendKeyEvent(true, "E", false, game);
				firetouchinterest(hrp, targetRoot, 0);
				task.wait(0.2);
				FlatIdent_8F047 = 2;
			end
		end
	end
	TweenService:Create(hrp, TweenInfo.new((hrp.Position - HomePos).Magnitude / _G.FlySpeed, Enum.EasingStyle.Linear), {CFrame=CFrame.new(HomePos)}):Play();
end
