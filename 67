-- [[ SKY TELEPORT ]]
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local SkyTab = Window:AddTab({
    Title = "Sky Teleport",
    Icon = "cloud"
})

local enabled = false
local savedCFrame = nil
local platform = nil
local respawnConnection = nil
local characterConnection = nil

local HEIGHT = 500

local function removePlatform()
    if platform then
        platform:Destroy()
        platform = nil
    end
end

local function createPlatform(position)
    removePlatform()

    platform = Instance.new("Part")
    platform.Name = "UHubSkyPlatform"
    platform.Size = Vector3.new(8000, 8000, 8000)
    platform.Anchored = true
    platform.CanCollide = true
    platform.Position = position - Vector3.new(0, 3, 0)
    platform.Parent = workspace
end

local function teleportCharacter(character)
    if not enabled then return end

    local root = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:WaitForChild("Humanoid", 10)

    if not root or not humanoid or humanoid.Health <= 0 then
        return
    end

    local destination

    if platform and platform.Parent then
        destination = platform.Position + Vector3.new(0, 3, 0)
    else
        destination = root.Position + Vector3.new(0, HEIGHT, 0)
        createPlatform(destination)
    end

    root.CFrame = CFrame.new(destination)
end

SkyTab:AddToggle("SkyTeleport", {
    Title = "Sky Teleport",
    Description = "เปิด = ขึ้นฟ้า | ปิด = กลับจุดเดิม",
    Default = false,

    Callback = function(value)
        enabled = value

        if value then
            local character = Player.Character
                or Player.CharacterAdded:Wait()

            local root = character:WaitForChild("HumanoidRootPart", 10)
            if not root then
                enabled = false
                return
            end

            savedCFrame = root.CFrame

            local destination = savedCFrame.Position
                + Vector3.new(0, HEIGHT, 0)

            createPlatform(destination)
            teleportCharacter(character)

            if respawnConnection then
                respawnConnection:Disconnect()
            end

            respawnConnection = Player.CharacterAdded:Connect(function(newCharacter)
                if enabled then
                    task.wait(1)
                    teleportCharacter(newCharacter)
                end
            end)
        else
            if respawnConnection then
                respawnConnection:Disconnect()
                respawnConnection = nil
            end

            local character = Player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if root and savedCFrame then
                root.CFrame = savedCFrame
            end

            removePlatform()
            savedCFrame = nil
        end
    end
})

